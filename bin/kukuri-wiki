#!/usr/bin/env python3
"""Living Wiki: what is known now. Updated from journal entries, never from guesses.

Journal = 何が起きたか / Living Wiki = 現在分かっていること / TODO = これから行うこと（kukuri-tasks）。
判断できない矛盾は「未確認・矛盾」に出典・日付つきで両方残す。決められるのは、日付と種類で優劣が明確な場合だけ。
"""
import argparse
import datetime as dt
import json
import os
import re
import runpy
import sys
import unicodedata
import uuid
from pathlib import Path

for _stream in (sys.stdout, sys.stderr):      # Windows consoles default to a legacy code page
    if hasattr(_stream, 'reconfigure'):
        _stream.reconfigure(encoding='utf-8')


AI = Path(__file__).resolve().parents[1]
journal = runpy.run_path(str(Path(__file__).resolve().parent / 'kukuri-journal'))
KINDS = journal['KINDS']
guard_write = journal['guard_write']
open_append = journal['open_append']
lock_exclusive = journal['lock_exclusive']
WIKI_REF = journal['WIKI_REF']
MARKER = '<!-- kukuri-wiki:v1 -->'
SEC_NOW, SEC_OPEN, SEC_HIST, SEC_APPLIED, SEC_NOTES = '現在わかっていること', '未確認・矛盾', '履歴', '反映済みの記録', '移行の記録'
ID_IN_TEXT = re.compile(r'j-[0-9]{8}-[0-9]{4}-[0-9]{2,}', re.ASCII)
SLUG = re.compile(r'[a-z0-9][a-z0-9-]*')
CONFIRMING = ('decision', 'result')       # 確定の根拠になる種類
CLAIM = re.compile(r'^- \[([A-Za-z0-9_-]+)\] (.*)$')
STALE_DAYS = 90


def pages_dir(ai):
    return ai / 'knowledge' / 'pages'


def norm(text):
    return re.sub(r'\s+', '', unicodedata.normalize('NFKC', text)).casefold()


def clean(text):
    return text.replace('|', '／').replace('\n', ' ').strip()


def parse_page(path):
    """None = 新形式ではない（既存の自由形式ページ。自動更新しない）。"""
    text = path.read_text(encoding='utf-8')
    if MARKER not in text:
        return None
    page = {'title': path.stem, 'claims': [], 'history': [], 'applied': set(), 'notes': []}
    has_applied = False
    section = None
    for line in text.splitlines():
        if line.startswith('# ') and page['title'] == path.stem:
            page['title'] = line[2:].strip()
        elif line.startswith('## '):
            section = line[3:].strip()
            has_applied = has_applied or section == SEC_APPLIED
        elif section in (SEC_NOW, SEC_OPEN):
            m = CLAIM.match(line)
            if not m:
                continue
            parts = [p.strip() for p in m.group(2).split(' | ')]
            claim = {'key': m.group(1), 'text': parts[0], 'as_of': None, 'time': None, 'source': None, 'kind': None,
                     'status': '確定' if section == SEC_NOW else '未確認'}
            for p in parts[1:]:
                k, _, v = p.partition(':')
                k, v = k.strip(), v.strip()
                if k == 'time':
                    claim['time'] = v
                elif k in ('as_of', 'source', 'kind'):
                    claim[k] = v
                elif k == '状態':
                    claim['status'] = v
            page['claims'].append(claim)
        elif section == SEC_HIST and line.startswith('- '):
            page['history'].append(line[2:])
        elif section == SEC_APPLIED and line.startswith('- '):
            page['applied'].add(line[2:].strip())
        elif section == SEC_NOTES and line.startswith('- '):
            page['notes'].append(line[2:])
    page['ledger'] = has_applied
    if not has_applied:
        # 反映済みの記録の節が無い旧ページ: 確定・未確認の出典と、履歴の [key] と記録IDから復元する
        for c in page['claims']:
            if c['source']:
                page['applied'].add('%s#%s' % (c['source'], c['key']))
        for h in page['history']:
            m = re.search(r'\[([A-Za-z0-9_-]+)\]', h)
            if m:
                for rid in ID_IN_TEXT.findall(h):
                    page['applied'].add('%s#%s' % (rid, m.group(1)))
    return page


def render(page, today):
    out = ['# ' + page['title'], '', MARKER, '', '更新: ' + today, '',
           '種別: Living Wiki（現在分かっていること）。過去の経緯は knowledge/journal、これからの仕事は tasks。', '']
    def line(c):
        s = '- [%s] %s | as_of: %s | source: %s | kind: %s' % (c['key'], clean(c['text']), c['as_of'], c['source'], c['kind'])
        if c.get('time'):
            s += ' | time: ' + c['time']
        if c['status'] not in ('確定',):
            s += ' | 状態: ' + c['status']
        return s
    confirmed = [c for c in page['claims'] if c['status'] == '確定']
    opened = [c for c in page['claims'] if c['status'] != '確定']
    out += ['## ' + SEC_NOW] + [line(c) for c in confirmed] + ['']
    out += ['## ' + SEC_OPEN] + [line(c) for c in opened] + ['']
    out += ['## ' + SEC_HIST] + ['- ' + h for h in page['history']] + ['']
    out += ['## ' + SEC_APPLIED, '（機械が読む欄。どの記録のどのキーを反映したかを保持し、再実行で結果を変えないために使う）']
    out += ['- ' + a for a in sorted(page.get('applied', ()))] + ['']
    if page.get('notes'):
        out += ['## ' + SEC_NOTES] + ['- ' + n for n in page['notes']] + ['']
    return '\n'.join(out)


def entry_refs(entries):
    for e in entries:
        for ref in e['wiki']:
            m = WIKI_REF.match(ref)
            if m:
                yield e, m.group(1), m.group(2), m.group(3).strip()


def replay(refs, title):
    """ある1ページ宛ての全記録を、日時順に最初から判断し直す。結果は、追記順にも、applyの回数にも依存しない。"""
    page = {'title': title, 'claims': [], 'history': [], 'applied': set(), 'notes': []}
    actions = []
    for e, key, text in sorted(refs, key=lambda r: (r[0]['date'], r[0]['time'], r[0]['id'], r[1])):
        act = decide(page, e, key, text)
        act.update(entry=e['id'], key=key)
        actions.append(act)
        apply_action(page, e, key, text, act)
    return page, actions


def same_page(old, new):
    def claims(p):
        return sorted((c['key'] or '', c['text'] or '', c['as_of'] or '', c.get('time') or '', c['source'] or '',
                       c['kind'] or '', c['status'] or '') for c in p['claims'])
    return (claims(old) == claims(new) and list(old['history']) == list(new['history'])
            and set(old['applied']) == set(new['applied']))


def plan(ai, entries=None, report=None):
    """Journal全体 -> ページごとの再構成と、記録ごとの判断。ここでは何も書かない。

    entries: 判断に使う全記録（省略時はJournal全体）。report: 結果に載せる記録ID（省略時は全て）。
    """
    entries = journal['all_entries'](ai) if entries is None else entries
    known_ids = {e['id'] for e in journal['all_entries'](ai)}
    by_slug = {}
    for e, slug, key, text in entry_refs(entries):
        by_slug.setdefault(slug, []).append((e, key, text))
    actions, pages = [], {}

    def note(slug, refs, action, reason):
        for e, key, _ in refs:
            if report is None or e['id'] in report:
                actions.append({'entry': e['id'], 'page': slug, 'key': key, 'action': action, 'reason': reason})

    for slug in sorted(by_slug):
        refs = by_slug[slug]
        path = pages_dir(ai) / (slug + '.md')
        old = None
        if path.exists():
            if path.is_symlink() or not journal['real_inside'](ai, path):
                note(slug, refs, 'manual_review', 'シンボリックリンク（またはワークスペース外へ解決される）ページは、読み取りも更新もしない')
                continue
            old = parse_page(path)
            if old is None:
                note(slug, refs, 'manual_legacy_page', '既存の自由形式ページは自動更新しない。人が内容を確認して移す')
                continue
            if not old.get('ledger') and (old['claims'] or old['history']):
                note(slug, refs, 'migration_required',
                     '反映済みの記録の台帳が無い旧版のページ。内容を確認してから '
                     'kukuri-wiki migrate %s --write で、Journalから再構成して台帳を付ける' % slug)
                continue
            current_pairs = {'%s#%s' % (e['id'], key) for e, key, _ in refs}
            lost = sorted(old['applied'] - current_pairs)
            if lost:
                note(slug, refs, 'missing_source',
                     '以前に反映した記録がJournalに揃っていない（%s）。再構成すると、履歴・出典を失うため、ページを変更せず停止する。'
                     'Journalを復元するか、人が内容を確認してください' % ', '.join(lost[:5]) + (' ほか' if len(lost) > 5 else ''))
                continue
            foreign = [c['source'] or '(出典なし)' for c in old['claims'] if c['source'] not in known_ids]
            if foreign:
                note(slug, refs, 'manual_review',
                     'Journalに無い出典の主張がある（%s）。手で編集されたページは、自動で再構成しない' % ', '.join(sorted(set(foreign))))
                continue
        new, acts = replay(refs, old['title'] if old else slug)
        changed = old is None or not same_page(old, new)
        for act in acts:
            if report is not None and act['entry'] not in report:
                continue
            act['page'] = slug
            if not changed:
                act = {**act, 'action': 'skip', 'reason': '反映済み（ページは最新）'}
            actions.append(act)
        if changed:
            new['new'] = old is None
            new['notes'] = list(old['notes']) if old else []
            pages[slug] = new
    return actions, pages


def claim_time(c):
    """時刻を持たない旧い主張は、出典の記録ID（j-YYYYMMDD-HHMM-NN）から時刻を復元する。"""
    if c.get('time'):
        return c['time']
    m = re.match(r'^j-[0-9]{8}-([0-9]{2})([0-9]{2})-', c.get('source') or '', re.ASCII)
    return '%s:%s' % m.groups() if m else ''


def decide(page, e, key, text):
    current = [c for c in page['claims'] if c['key'] == key]
    if '%s#%s' % (e['id'], key) in page['applied']:
        return {'action': 'skip', 'reason': '同じ記録の同じキーは反映済み'}
    confirmed = [c for c in current if c['status'] == '確定']
    opened = [c for c in current if c['status'] != '確定']
    confirms = e['kind'] in CONFIRMING
    if not current:
        return {'action': 'add' if confirms else 'add_unconfirmed',
                'reason': '新しい事実' if confirms else '提案・観察・依頼は確定扱いにせず未確認として追加'}
    es = (e['date'], e['time'])                      # 記録の日時。日付だけでなく時刻まで比べる
    if confirmed:
        c = confirmed[0]
        cs = (c['as_of'] or '', claim_time(c))
        old = {'old': c['text'], 'old_source': c['source'], 'old_as_of': c['as_of']}
        if norm(c['text']) == norm(text):
            if confirms and es > cs:
                return {'action': 'refresh', 'reason': 'より新しい決定・結果で同じ内容を再確認（日時を更新）'}
            return {'action': 'skip', 'reason': '確定済みの内容の再言及（提案・観察・古い記録）は、根拠を置き換えない'}
        owner_over = e['kind'] == 'decision' and c['kind'] != 'decision' and es >= cs
        if es < cs:
            if e['date'] == c['as_of'] and e['kind'] == 'decision' and c['kind'] == 'result':
                # 日時順に再生すれば「決定 → 異なる結果」の競合になる。遅れて届いても同じ扱いにする
                return {'action': 'conflict', 'reason': '同日の、より後の結果と異なる決定の記録が遅れて届いたため、両方を未確認として保持', **old}
            return {'action': 'note_older', 'reason': '確定済みの記述より古い記録のため置換しない（履歴に、出典つきで記録する）', **old}
        date_newer = e['date'] > (c['as_of'] or '')
        # 同じ日でも、同じ種類（決定どうし・結果どうし）の、より遅い時刻の記録は、更新として扱う
        same_day_later = (e['date'] == c['as_of'] and e['kind'] == c['kind'] and bool(claim_time(c))
                          and e['time'] > claim_time(c))
        if confirms and (date_newer or owner_over or same_day_later):
            return {'action': 'supersede', 'reason': '後日の決定・結果で置換（旧記述は履歴に出典つきで保持）', **old}
        return {'action': 'conflict', 'reason': '日付または種類で優劣を決められないため、両方を未確認として保持', **old}
    latest = max((c['as_of'] or '', claim_time(c)) for c in opened)
    if confirms and es >= latest:
        return {'action': 'resolve', 'reason': '決定・結果で未確認事項を解消（旧候補は履歴に保持）',
                'old': ' / '.join(c['text'] for c in opened)}
    if confirms and es < latest:
        newest = max(opened, key=lambda c: (c['as_of'] or '', claim_time(c)))
        return {'action': 'note_older', 'reason': '未確認事項より古い決定・結果のため、解消に使わない（履歴に、出典つきで記録する）',
                'old': ' / '.join(c['text'] for c in opened), 'old_source': newest['source'], 'old_as_of': newest['as_of']}
    for c in opened:
        if norm(c['text']) == norm(text):
            if es > (c['as_of'] or '', claim_time(c)):
                return {'action': 'refresh_open', 'reason': '未確認のまま再観測（日時と出典を更新）'}
            return {'action': 'skip', 'reason': '古い再観測は、根拠を巻き戻さない'}
    return {'action': 'conflict_add', 'reason': '未確認の別候補を追加（確定の根拠になる記録ではない）'}


def apply_action(page, e, key, text, act):
    a = act['action']
    if a not in ('skip', 'manual_legacy_page'):
        page['applied'].add('%s#%s' % (e['id'], key))
    new = {'key': key, 'text': text, 'as_of': e['date'], 'time': e['time'], 'source': e['id'], 'kind': e['kind'],
           'status': '確定'}
    if a == 'add':
        page['claims'].append(new)
    elif a == 'add_unconfirmed':
        new['status'] = '未確認'; page['claims'].append(new)
    elif a == 'refresh':
        for c in page['claims']:
            if c['key'] == key and c['status'] == '確定':
                c.update(as_of=e['date'], time=e['time'], source=e['id'], kind=e['kind'])
        page['history'].append('%s [%s] 再確認: %s（%s）' % (e['date'], key, clean(text), e['id']))
    elif a == 'supersede':
        page['claims'] = [c for c in page['claims'] if not (c['key'] == key and c['status'] == '確定')]
        page['history'].append('%s [%s] 更新: 旧「%s」(%s, %s) → 新「%s」(%s, %s)' % (
            e['date'], key, clean(act['old']), act['old_as_of'], act['old_source'], clean(text), e['date'], e['id']))
        page['claims'].append(new)
    elif a == 'conflict':
        for c in page['claims']:
            if c['key'] == key and c['status'] == '確定':
                c['status'] = '競合'
        new['status'] = '競合'; page['claims'].append(new)
        page['history'].append('%s [%s] 競合: 「%s」(%s) と「%s」(%s) を未確認として保持' % (
            e['date'], key, clean(act['old']), act['old_source'], clean(text), e['id']))
    elif a == 'note_older':
        page['history'].append('%s [%s] 古い記録（置換せず）: 「%s」(%s)。確定済みは「%s」(%s, %s)' % (
            e['date'], key, clean(text), e['id'], clean(act['old']), act['old_as_of'], act['old_source']))
    elif a == 'conflict_add':
        new['status'] = '未確認'; page['claims'].append(new)
    elif a == 'resolve':
        page['claims'] = [c for c in page['claims'] if c['key'] != key]
        page['history'].append('%s [%s] 解消: 旧候補「%s」→「%s」(%s)' % (e['date'], key, clean(act['old']), clean(text), e['id']))
        page['claims'].append(new)
    elif a == 'refresh_open':
        for c in page['claims']:
            if c['key'] == key and norm(c['text']) == norm(text):
                c.update(as_of=e['date'], time=e['time'], source=e['id'], kind=e['kind'])


def check(ai):
    problems, stats = [], {'pages': 0, 'confirmed': 0, 'unconfirmed': 0, 'conflict': 0, 'stale': 0, 'legacy_pages': 0, 'needs_migration': 0}
    today = dt.date.today()
    for path in sorted(pages_dir(ai).glob('*.md')):
        page = parse_page(path)
        if page is None:
            stats['legacy_pages'] += 1
            continue
        stats['pages'] += 1
        if not page.get('ledger') and (page['claims'] or page['history']):
            stats['needs_migration'] += 1
        for c in page['claims']:
            where = '%s#%s' % (path.stem, c['key'])
            if not c['as_of'] or not re.match(r'^\d{4}-\d{2}-\d{2}$', c['as_of']):
                problems.append(where + ': as_of がありません'); continue
            if not c['source']:
                problems.append(where + ': 出典がありません')
            elif c['source'].startswith('j-'):
                try:
                    journal['find_entry'](ai, c['source'])
                except ValueError:
                    problems.append(where + ': 出典の記録が見つかりません ' + c['source'])
            if c['kind'] not in KINDS:
                problems.append(where + ': kind が不正です')
            if dt.date.fromisoformat(c['as_of']) > today:
                problems.append(where + ': as_of が未来です')
            if c['status'] == '確定':
                stats['confirmed'] += 1
                if (today - dt.date.fromisoformat(c['as_of'])).days > STALE_DAYS:
                    stats['stale'] += 1
            elif c['status'] == '競合':
                stats['conflict'] += 1
            else:
                stats['unconfirmed'] += 1
    return {'stats': stats, 'problems': problems}


def run_plan(args, write):
    entries = journal['all_entries'](AI)
    selected = journal['all_entries'](AI, args.date) if args.date else entries
    report = {e['id'] for e in selected}
    if args.entry:
        report &= set(args.entry)
    actions, pages = plan(AI, entries, report)
    if args.date or args.entry:
        # 絞り込み（--date / --entry）を指定したときは、選んだ記録が宛てるページだけを書く
        targets = {slug for e, slug, key, text in entry_refs(entries) if e['id'] in report}
        pages = {slug: page for slug, page in pages.items() if slug in targets}
    result = {'actions': actions, 'written': []}
    if write:
        today = dt.date.today().isoformat()
        for slug in sorted(pages):                      # 先に全ページの書き込み先を確認する
            guard_write(AI, pages_dir(AI) / (slug + '.md'))
        pages_dir(AI).mkdir(parents=True, exist_ok=True)
        for slug in sorted(pages):
            write_page(pages_dir(AI) / (slug + '.md'), pages[slug], today)
            result['written'].append(slug)
    return result


def write_page(path, page, today):
    page.pop('new', None)
    target = guard_write(AI, path)
    temporary = target.with_name('.%s.%d.%s.tmp' % (target.name, os.getpid(), uuid.uuid4().hex[:8]))
    fd = os.open(str(temporary), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as out:
            out.write(render(page, today))
        os.replace(temporary, target)
    finally:
        if temporary.exists():
            temporary.unlink()


def migrate(args):
    """台帳の無い旧版ページを、Journalから再構成して、台帳つきに移す。--write までは何も書かない。"""
    if not SLUG.fullmatch(args.slug):
        raise ValueError('slug は小文字英数字とハイフンです')
    if args.through is not None:
        journal['one_line']('確認した日付', args.through)
        journal['valid_date'](args.through)
    path = pages_dir(AI) / (args.slug + '.md')

    def build():
        if path.is_symlink() or (path.exists() and not journal['real_inside'](AI, path)):
            raise ValueError('シンボリックリンク（またはワークスペース外へ解決される）ページは移行しません')
        old = parse_page(path) if path.exists() else None
        if old is None:
            raise ValueError('新形式のページではありません: ' + args.slug)
        refs = [(e, key, text) for e, slug, key, text in entry_refs(journal['all_entries'](AI)) if slug == args.slug]
        if not refs:
            raise ValueError('このページを更新するJournalの記録がありません')
        new, _ = replay(refs, old['title'])
        return old, new

    def brief(p):
        return sorted('%s=%s[%s]' % (c['key'], c['text'], c['status']) for c in p['claims'])

    if not args.write:
        old, new = build()
        return {'page': args.slug, 'before': brief(old), 'after': brief(new), 'changed': brief(old) != brief(new),
                'confirmed_through': args.through, 'written': False}
    guard_write(AI, pages_dir(AI) / '.wiki.lock')
    with open_append(AI, pages_dir(AI) / '.wiki.lock') as lock:
        lock_exclusive(lock)
        old, new = build()                       # 読み取り・再構成・書き込みを、同じロックの中で行う
        note = '%s 台帳を移行: Journalの全記録から再構成（人の確認済みの日付: %s）' % (
            dt.date.today().isoformat(), args.through or '指定なし')
        new['notes'] = list(old['notes']) + ['(旧版の履歴) ' + h for h in old['history']] + [note]
        write_page(path, new, dt.date.today().isoformat())
    return {'page': args.slug, 'before': brief(old), 'after': brief(new), 'changed': brief(old) != brief(new),
            'confirmed_through': args.through, 'written': True}


def main():
    ap = argparse.ArgumentParser(description='Living Wiki (what is known now)')
    sub = ap.add_subparsers(dest='command', required=True)
    for name in ('plan', 'apply'):
        p = sub.add_parser(name)
        p.add_argument('--date'); p.add_argument('--entry', action='append')
        if name == 'apply':
            p.add_argument('--write', action='store_true', help='指定しない限り何も書かない')
    s = sub.add_parser('show'); s.add_argument('slug')
    m = sub.add_parser('migrate'); m.add_argument('slug'); m.add_argument('--through', help='内容を確認した日付（記録用）'); m.add_argument('--write', action='store_true')
    sub.add_parser('check')
    args = ap.parse_args()
    try:
        if args.command in ('plan', 'apply'):
            if args.command == 'apply' and args.write:
                # 読み取り・判断・書き込みを、同じロックの中で行う（同時applyで更新を失わない）
                guard_write(AI, pages_dir(AI) / '.wiki.lock')
                pages_dir(AI).mkdir(parents=True, exist_ok=True)
                with open_append(AI, pages_dir(AI) / '.wiki.lock') as lock:
                    lock_exclusive(lock)
                    result = run_plan(args, write=True)
            else:
                result = run_plan(args, write=False)
        elif args.command == 'migrate':
            result = migrate(args)
        elif args.command == 'show':
            if not SLUG.fullmatch(args.slug):
                raise ValueError('slug は小文字英数字とハイフンです')
            page = parse_page(pages_dir(AI) / (args.slug + '.md'))
            if page is not None:
                page['applied'] = sorted(page['applied'])
            result = page if page is not None else {'error': '新形式のページではありません'}
        else:
            result = check(AI)
    except (ValueError, OSError) as error:
        print('停止: ' + str(error), file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 1 if args.command == 'check' and result['problems'] else 0


if __name__ == '__main__':
    sys.exit(main())
