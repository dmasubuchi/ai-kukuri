{
  "name": "ai-kukuri",
  "version": "0.1.0",
  "description": "ai-kukuri: Journal / Living Wiki / TODO for workspaces shared by several AIs (Claude Code, Codex, ...). Local, standard-library Python.",
  "license": "MIT",
  "private": true,
  "bin": {
    "ai-kukuri": "bin/ai-kukuri.js"
  },
  "files": [
    "bin",
    "rules",
    "skills",
    "templates",
    "locales",
    "scripts",
    "examples",
    "docs",
    "install.sh",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "NOTICE.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "journal",
    "wiki",
    "todo",
    "knowledge"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
